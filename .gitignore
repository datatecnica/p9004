# This directory holds restricted PPMI data, so this is an ALLOWLIST, not a blocklist:
# ignore everything, then re-admit only the build code, analysis config and
# documentation at the top level. Nothing from any subdirectory is committable — git
# does not descend into an ignored directory, so build_intermediates/, EDA_PCA_plots/,
# initial_build_assets/, clinical_and_p9001_updates/ and anything added later are
# excluded by default rather than by remembering to name them.

# Ignore everything.
*

# ...except these, at the top level only (the leading / anchors to this directory).
!/.gitignore
!/LICENSE
!/*.py
!/*.md
!/*.yaml
!/requirements.txt

# Results directories produced by the analysis batch. These are per-analyte summary
# statistics rather than participant-level records, but they run 7-10 MB per run x
# stratum and regenerate from the config, so they are not committed.
results/
meta/
plots/
